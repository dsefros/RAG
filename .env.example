ENVIRONMENT=dev
DOCUMENT_ROOT=data/docs
LLM_BACKEND=llama_cpp

API__HOST=0.0.0.0
API__PORT=8000
API__REQUEST_TIMEOUT_SECONDS=60
API__MAX_QUERY_CHARS=4000
API__GENERATION_CONCURRENCY=4
API__GENERATION_ACQUIRE_TIMEOUT_SECONDS=5

POSTGRES__DSN=postgresql+psycopg://postgres:postgres@localhost:5432/rag
QDRANT__URL=http://localhost:6333
QDRANT__ACTIVE_ALIAS=rag_docs_active

LLAMA_CPP__MODEL_PATH=models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
LLAMA_CPP__N_CTX=4096
LLAMA_CPP__N_GPU_LAYERS=-1
LLAMA_CPP__N_THREADS=8
LLAMA_CPP__TEMPERATURE=0.1
LLAMA_CPP__MAX_TOKENS=512

OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__MODEL=mistral
OLLAMA__TEMPERATURE=0.1
OLLAMA__MAX_TOKENS=512
OLLAMA__CONTEXT_WINDOW=4096

RETRIEVAL__EMBEDDING_MODEL_NAME=BAAI/bge-m3
RETRIEVAL__RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RETRIEVAL__INITIAL_TOP_K=40
RETRIEVAL__RERANK_TOP_K=12
RETRIEVAL__FINAL_TOP_K=8
RETRIEVAL__MAX_CONTEXT_TOKENS=3000
RETRIEVAL__RESERVED_OUTPUT_TOKENS=512

CHUNKING__CHUNK_SIZE_TOKENS=350
CHUNKING__CHUNK_OVERLAP_TOKENS=60
CHUNKING__MIN_CHUNK_CHARS=30

REINDEX__KEEP_LAST_VERSIONS=2
REINDEX__VALIDATE_MIN_POINTS=1

AUTH__JWT_SECRET=change-me
AUTH__JWT_ALGORITHM=HS256
AUTH__TOKEN_TTL_MINUTES=120

LOGGING__LEVEL=INFO
# JSON map example for pydantic settings via env can be provided in .env as string:
# ACCESS_POLICY__FOLDER_DEFAULTS={"product":["support","ops"],"regulatory":["compliance"]}
